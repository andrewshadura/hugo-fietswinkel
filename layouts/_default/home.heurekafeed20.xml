{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<SHOP>
  {{- $sku_lists := slice }}
  {{- range $supplier := site.Params.suppliers }}
  {{-   with (or
      (resources.Get (printf "suppliers/%s/skulist.json" $supplier))
      (resources.Get (printf "suppliers/%s/skulist.csv" $supplier))
  ) }}
  {{-     $skus := transform.Unmarshal . }}
  {{-     $sku_lists = append $skus $sku_lists }}
  {{-   end }}
  {{- end }}

  {{- range where site.RegularPages "Section" "products" }}
  {{- $productID := partial "utils/get-product-id" . }}
  {{- $defaultProductID := partial "utils/get-default-product-id" . }}
  {{- if and $productID (ne (default false .Params.instoreonly) true) }}
  {{- end }}
  {{- if and $productID (or (eq (default false .Params.orderable) true) (gt (int .Params.instock) 0)) }}
  {{- $page := . }}
  {{- $params := .Params }}
  {{- $image := partial "utils/get-image" . }}
  {{- $option_colours := partial "utils/get-option-colours" . }}
  {{- $colours := or $option_colours (slice $params.Colour) }}
  {{- $args := slice }}
  {{- $colour_sku := "" }}
  {{- $colour_sku_arg := "" }}
  {{- $sizes := or $params.Sizes (slice $params.Size) }}
  {{- $full_name := partial "utils/get-product-full-name" . }}

    {{- range $size := $sizes }}
      {{- range $colour := $colours }}
        {{- $args = slice }}
        {{- if $colour }}
        {{- $colour_sku_arg = partial "utils/get-colour-product-id-arg" $colour }}
        {{- $colour_sku = partial "utils/get-colour-product-id" $colour }}
        {{- $colour = partial "utils/get-colour-name" $colour }}
        {{- end }}
        {{- $second_image := "" }}
        {{- if $option_colours }}
          {{- $args = slice "colour" (anchorize $colour) }}
          {{- if $page.Resources.GetMatch (printf "colours/%s.jpg" (anchorize $colour)) }}
            {{- $image = $page.Resources.GetMatch (printf "colours/%s.jpg" (anchorize $colour)) }}
            {{- $image = $image.Permalink }}
          {{- end }}
          {{- $second_image = $page.Resources.GetMatch (printf "colours/%s_2.jpg" (anchorize $colour)) }}
        {{- end }}

      {{- $size_name := partial "utils/get-size-name" $size }}
      {{- $size_id := partial "utils/get-size-product-id-arg" $size }}
      {{- $item_id := $productID }}
      {{- if $colour_sku }}
      {{-   $item_id = $colour_sku }}
      {{- end }}
      {{- $item_id = replace $item_id "{size}" (anchorize $size_id) }}
      {{- $item_id = replace $item_id "{colour}" $colour_sku_arg }}
      {{- if $colour }}
      {{-   if not (or $colour_sku (strings.Contains $productID "{colour}") $params.Colour) }}
      {{-     $item_id = printf "%s-%s" $item_id (anchorize $colour) }}
      {{-   end }}
      {{- end }}
      {{- if $size_name }}
      {{-   $args = append "size" $size_name $args }}
      {{-   if not (strings.Contains $productID "{size}") }}
      {{-     $item_id = printf "%s-%s" $item_id (anchorize $size_name) }}
      {{-   end }}
      {{- end }}
      {{- $product := dict }}
      {{- range $sku_list := $sku_lists }}
      {{-   $product = or $product (index $sku_list $item_id) }}
      {{- end }}
      <SHOPITEM>
          <ITEM_ID>{{ substr $item_id 0 36 }}</ITEM_ID>
          <PRODUCTNAME>{{- if strings.Contains $full_name "{" -}}
            {{- $final_full_name := $full_name -}}
            {{- if $colour -}}
              {{- $final_full_name = replace $final_full_name "{colour}" (default (i18n $colour) $colour) -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{colour}" "" -}}
            {{- end }}
            {{- if $size_name -}}
              {{- $final_full_name = replace $final_full_name "{size}" $size_name -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{size}" "" -}}
            {{- end -}}
            {{- if $params.Variant -}}
              {{- $final_full_name = replace $final_full_name "{variant}" $params.Variant -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{variant}" "" -}}
            {{- end -}}
            {{- if $params.Parameters -}}
              {{- if and $params.Parameters $params.Parameters.Wheel_size -}}
                {{- $final_full_name = replace $final_full_name "{wheel_size}" (partial "utils/get-wheel-size" $page) -}}
              {{- else -}}
                {{- $final_full_name = replace $final_full_name "{wheel_size}" "" -}}
              {{- end -}}
              {{- if $params.Parameters.Model_year }}
                {{- $final_full_name = replace $final_full_name "{model_year}" $params.Parameters.Model_year }}
              {{- end }}
            {{- end -}}
            {{- if $params.Model_year }}
              {{- $final_full_name = replace $final_full_name "{model_year}" $params.Model_year }}
            {{- end }}
          {{- $final_full_name = replace $final_full_name "  " " " -}}
          {{- $final_full_name -}}
          {{- else -}}
            {{ $full_name }}{{ if $colour }} {{ i18n $colour | default $colour }}{{ end }}{{ if $size_name }} {{ $size_name }}{{ end }}
          {{- end -}}
          </PRODUCTNAME>
          <PRODUCT>{{- if strings.Contains $full_name "{" -}}
            {{- $final_full_name := $full_name -}}
            {{- if $colour -}}
              {{- $final_full_name = replace $final_full_name "{colour}" (default (i18n $colour) $colour) -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{colour}" "" -}}
            {{- end }}
            {{- if $size_name -}}
              {{- $final_full_name = replace $final_full_name "{size}" $size_name -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{size}" "" -}}
            {{- end -}}
            {{- if $params.Variant -}}
              {{- $final_full_name = replace $final_full_name "{variant}" $params.Variant -}}
            {{- else -}}
              {{- $final_full_name = replace $final_full_name "{variant}" "" -}}
            {{- end -}}
            {{- if $params.Parameters -}}
              {{- if and $params.Parameters $params.Parameters.Wheel_size -}}
                {{- $final_full_name = replace $final_full_name "{wheel_size}" (partial "utils/get-wheel-size" $page) -}}
              {{- else -}}
                {{- $final_full_name = replace $final_full_name "{wheel_size}" "" -}}
              {{- end -}}
              {{- if $params.Parameters.Model_year }}
                {{- $final_full_name = replace $final_full_name "{model_year}" $params.Parameters.Model_year }}
              {{- end }}
            {{- end -}}
            {{- if $params.Model_year }}
              {{- $final_full_name = replace $final_full_name "{model_year}" $params.Model_year }}
            {{- end }}
          {{- $final_full_name = replace $final_full_name "  " " " -}}
          {{- $final_full_name -}}
          {{- else -}}
            {{ $full_name }}{{ if $colour }} {{ i18n $colour | default $colour }}{{ end }}{{ if $size_name }} {{ $size_name }}{{ end }}
          {{- end -}}
          </PRODUCT>
          <DESCRIPTION>
            {{- $descr_slice := slice }}
            {{- if $page.Description }}{{ $descr_slice = append $page.Description $descr_slice }}{{ end }}
            {{- $descr_slice = append $page.Summary $descr_slice }}
            {{- replace (replace (replace (replace (replace (replace (replace (replace (
              htmlUnescape (delimit $descr_slice ".\n")
              ) "&" "&amp;"
              ) "\"" "&#34;"
              ) "'" "&#39;"
              ) "<" "&lt;"
              ) ">" "&gt;"
              ) "\t" "&#x9;"
              ) "\n" "&#xA;"
              ) "\r" "&#xD;"
              | safeHTML}}
          </DESCRIPTION>
          <URL>{{ $page.Permalink | absURL }}{{ if $args }}?{{ end }}{{ querify $args }}</URL>
          <IMGURL>{{ $image }}</IMGURL>
          {{- if $second_image }}
          <IMGURL_ALTERNATIVE>{{ $second_image.Permalink }}</IMGURL_ALTERNATIVE>
          {{- end }}
          {{- if $product }}
          <EAN>{{ $product.ean }}</EAN>
          {{- else }}
          {{-   if $params.EAN }}
          <EAN>{{ $params.EAN }}</EAN>
          {{-   end }}
          {{- end }}
          {{- if $colour }}
          <PARAM>
            <PARAM_NAME>FARBA</PARAM_NAME>
            <VAL>{{ i18n $colour | default $colour }}</VAL>
          </PARAM>
          {{- end }}
          {{- if $size_name }}
          <PARAM>
            <PARAM_NAME>VEĽKOSŤ</PARAM_NAME>
            <VAL>{{ $size_name }}</VAL>
          </PARAM>
          {{- end }}
          {{- $param_keys := slice }}
          {{- range $k, $v := $params.Parameters }}
          {{- $param_keys = append $param_keys (slice $k) }}
          {{- end }}
          {{- range $param := intersect site.Params.ParameterOrder $param_keys }}
          <PARAM>
            <PARAM_NAME>{{ i18n (humanize $param) | default (humanize $param) }}</PARAM_NAME>
            <VAL>{{ index $params.Parameters $param }}</VAL>
          </PARAM>
          {{- end }}
          {{- range $param := complement site.Params.ParameterOrder $param_keys }}
          <PARAM>
            <PARAM_NAME>{{ i18n (humanize $param) | default (humanize $param) }}</PARAM_NAME>
            <VAL>{{ i18n (index $params.Parameters $param | humanize) | default (index $params.Parameters $param) }}</VAL>
          </PARAM>
          {{- end }}
          <PRICE_VAT>{{ $params.Price }}</PRICE_VAT>
          {{- if $params.Group_ID }}
          <ITEMGROUP_ID>{{ replace (substr (string $params.Group_ID) 0 36) "." "-" | anchorize }}</ITEMGROUP_ID>
          {{- else if or $colour $size_name }}
          <ITEMGROUP_ID>{{ replace (substr (string $defaultProductID) 0 36) "." "-" | anchorize }}</ITEMGROUP_ID>
          {{- end }}
          {{- if $params.Heurekacategory }}
          <CATEGORYTEXT>{{ replace $params.Heurekacategory "Heureka.sk | " "" }}</CATEGORYTEXT>
          {{- end }}
          {{- if $params.Manufacturer }}
          <MANUFACTURER>{{ $params.Manufacturer }}</MANUFACTURER>

          <PARAM>
            <PARAM_NAME>Výrobca</PARAM_NAME>
            <VAL>{{ $params.Manufacturer }}</VAL>
          </PARAM>
          {{- end }}
          {{- if $params.Showroom_Sizes }}
          {{-   if in (partial "utils/stringify-list" $params.Showroom_Sizes) $size_name }}
          <DELIVERY_DATE>0</DELIVERY_DATE>
          {{-   else }}
          {{-     if $params.Lead_Time }}
          <DELIVERY_DATE>{{ $params.Lead_Time }}</DELIVERY_DATE>
          {{-     end }}
          {{-   end }}
          {{- end }}
          {{- range $k, $v := $params.Heureka }}
          {{- if $v }}
          {{- if reflect.IsSlice $v }}
          {{-   range $vv := $v }}
          {{-     if reflect.IsMap $vv }}
          {{-       printf "<%s>" (upper $k) | safeHTML }}
          {{-       range $kkk, $vvv := $vv }}
          {{-         printf "<%s>" (upper $kkk) | safeHTML }}{{ $vvv }}{{ printf "</%s>" (upper $kkk) | safeHTML -}}
          {{-       end }}
          {{-       printf "</%s>" (upper $k) | safeHTML -}}
          {{-     else }}
          {{-       printf "<%s>" (upper $k) | safeHTML }}{{ $vv }}{{ printf "</%s>" (upper $k) | safeHTML -}}
          {{-     end }}
          {{-   end }}
          {{- else }}
          {{-   printf "<%s>" (upper $k) | safeHTML }}{{ $v }}{{ printf "</%s>" (upper $k) | safeHTML -}}
          {{- end }}
          {{- end }}
          {{- end }}
      </SHOPITEM>
      {{- end }}
    {{- end }}
  {{- end }}
  {{- end }}
</SHOP>
